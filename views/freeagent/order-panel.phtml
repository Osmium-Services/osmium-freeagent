<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">FreeAgent</h5></div>
    <div class="card-body">
        <?php if ($freeagent['synced']) : ?>
            <p class="mb-1"><span class="badge bg-success">Pushed to FreeAgent</span></p>
            <p class="small text-muted mb-0">
                <?= $freeagent['invoiceNumber'] ? 'Invoice ' . \htmlspecialchars((string) $freeagent['invoiceNumber']) . ', synced ' : 'Synced ' ?>
                <?= \htmlspecialchars((string) $freeagent['syncedAt']) ?>
            </p>
        <?php elseif ($freeagent['canPush']) : ?>
            <button type="button" class="btn btn-outline-primary btn-sm w-100" id="pushToFreeagentBtn">Push to FreeAgent</button>
            <p class="small text-muted mt-2 mb-0">Creates an open sales invoice in FreeAgent. This cannot be undone from here.</p>
        <?php else : ?>
            <p class="small text-muted mb-0">Only a paid order can be pushed to FreeAgent.</p>
        <?php endif; ?>
    </div>
</div>
<?php if ($freeagent['canPush']) : ?>
<script nonce="<?= $cspNonce ?? '' ?>">
document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('pushToFreeagentBtn');
    if (!btn || !window.osmiumOrder) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;
        window.osmiumOrder.post({ action: 'push_to_freeagent' }).then(function (data) {
            if (!data.success) {
                window.osmiumOrder.feedback(data.error || 'Could not push to FreeAgent', true);
                btn.disabled = false;
                return;
            }
            window.osmiumOrder.returnToOrder();
        });
    });
});
</script>
<?php endif; ?>
