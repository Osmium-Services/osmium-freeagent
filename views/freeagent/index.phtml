<script>
window.csrfToken = <?= \json_encode($template['formToken'] ?? '') ?>;

async function postFreeagentAction(action) {
    const response = await fetch('<?= $admin['basePath'] ?>settings/freeagent/action/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, csrf_token: window.csrfToken }),
    });
    return response.json();
}

async function testConnection() {
    const resultEl = document.getElementById('freeagentActionResult');
    resultEl.textContent = 'Testing...';

    const result = await postFreeagentAction('test_connection');
    resultEl.innerHTML = '';
    const alert = document.createElement('div');
    alert.className = 'alert mb-0 alert-' + (result.success ? 'success' : 'danger');
    alert.textContent = result.success ? 'Connected to "' + (result.company || '') + '".' : (result.error || 'Connection test failed');
    resultEl.appendChild(alert);
}

async function disconnectFreeagent() {
    // Not confirm(): native dialogs block browser automation; reconnecting is one click.
    const result = await postFreeagentAction('disconnect');
    if (result.success) window.location.reload();
    else document.getElementById('freeagentActionResult').textContent = result.error || 'Failed to disconnect';
}
</script>
